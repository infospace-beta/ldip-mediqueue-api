# Copy this file to .env and fill in your local PostgreSQL credentials.
# Never commit the actual .env file.

DB_URL=jdbc:postgresql://localhost:5432/mediqueue
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password

# Replace with a unique random secret of at least 32 bytes before starting the API.
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
